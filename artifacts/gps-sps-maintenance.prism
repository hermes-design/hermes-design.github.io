// PRISM-games CSG (concurrent stochastic game) generated by HERMES / CPC Modeler
csg

player env environment endplayer
player o onorbitstaff endplayer
player g ongroundstaff endplayer

const int k = 30;
const double t_round = 0.5;
const double MTBF_ST = 0.5;
const double MTBF_LT = 15;
const double MTBF_SOFT = 7.5;
const double EULER = 2.718281828459045;
const double pr_st = 1 - pow(EULER, -t_round/MTBF_ST);
const double pr_lt = 1 - pow(EULER, -t_round/MTBF_LT);
const double pr_soft = 1 - pow(EULER, -t_round/MTBF_SOFT);
const double pr_uns = 0.1;
const double p_umsi = 1e-5;
const double p_eol = 0.6;
const double Pbeta = 0.8;
const double pr_build = 0.9;
const double Pn = 0.9;
const double OnGroundPriority = 0.5;

module environment
  env_ready : [0..1] init 0; // 0: ENV

  [e_none] env_ready=0 & (sat=0) -> 1 : (env_ready'=0);
  [e_uns] env_ready=0 & (sat=0) -> 1 : (env_ready'=0);
  [e_st] env_ready=0 & (sat=0) -> 1 : (env_ready'=0);
  [e_lt] env_ready=0 & (sat=0) -> 1 : (env_ready'=0);
  [e_soft] env_ready=0 & (sat=0) -> 1 : (env_ready'=0);
  [e_wait] env_ready=0 & (sat>0) -> 1 : (env_ready'=0);
endmodule

module onorbitstaff
  o_ready : [0..1] init 0; // 0: PO

  [o_stby] o_ready=0 -> 1 : (o_ready'=0);
  [o_take] o_ready=0 & (sat=2) -> 1 : (o_ready'=0);
  [o_switch] o_ready=0 & ((sat=4 & ostage=0) | sat=7) -> 1 : (o_ready'=0);
  [o_replace] o_ready=0 & (sat=4 & ostage=1) -> 1 : (o_ready'=0);
endmodule

module ongroundstaff
  g_ready : [0..1] init 0; // 0: PG

  [g_stby] g_ready=0 -> 1 : (g_ready'=0);
  [g_take] g_ready=0 & (sat=2) -> 1 : (g_ready'=0);
  [g_check] g_ready=0 & (sat=5 & gstage=0) -> 1 : (g_ready'=0);
  [g_build] g_ready=0 & (sat=5 & gstage=1) -> 1 : (g_ready'=0);
  [g_launch] g_ready=0 & (sat=5 & gstage=2) -> 1 : (g_ready'=0);
endmodule

module maintenance
  sat : [0..7] init 0;
  ostage : [0..1] init 0;
  gstage : [0..2] init 0;
  win : [0..2] init 0;
  last : [0..2] init 0;

  [e_none,o_stby,g_stby] sat=0 -> 1 : (last'=0);
  [e_uns,o_stby,g_stby] sat=0 -> pr_uns : (sat'=1) & (last'=0) + 1-pr_uns : (last'=0);
  [e_st,o_stby,g_stby] sat=0 -> pr_st : (sat'=7) & (last'=0) + 1-pr_st : (last'=0);
  [e_lt,o_stby,g_stby] sat=0 -> pr_lt : (sat'=2) & (last'=0) + 1-pr_lt : (last'=0);
  [e_soft,o_stby,g_stby] sat=0 -> pr_soft : (sat'=3) & (last'=0) + 1-pr_soft : (last'=0);
  [e_wait,o_stby,g_stby] sat=1 -> 1 : (sat'=0);
  [e_wait,o_stby,g_stby] sat=3 -> 1-p_umsi : (sat'=0) + p_umsi : (sat'=6);
  [e_wait,o_stby,g_stby] sat=6 -> 1 : (sat'=0);
  [e_wait,o_take,g_stby] sat=2 -> 1 : (sat'=4) & (win'=1) & (ostage'=0);
  [e_wait,o_stby,g_take] sat=2 -> 1 : (sat'=5) & (win'=2) & (gstage'=0);
  [e_wait,o_take,g_take] sat=2 -> OnGroundPriority : (sat'=5) & (win'=2) & (gstage'=0) + 1-OnGroundPriority : (sat'=4) & (win'=1) & (ostage'=0);
  [e_wait,o_switch,g_stby] sat=7 -> Pbeta : (sat'=0) & (last'=1) + 1-Pbeta : true;
  [e_wait,o_switch,g_stby] sat=4 & ostage=0 -> Pbeta*(1-p_eol) : (sat'=0) & (win'=0) & (last'=1) + 1-Pbeta*(1-p_eol) : (ostage'=1);
  [e_wait,o_replace,g_stby] sat=4 & ostage=1 -> Pbeta : (sat'=0) & (win'=0) & (ostage'=0) & (last'=1) + 1-Pbeta : (sat'=5) & (win'=2) & (ostage'=0) & (gstage'=0);
  [e_wait,o_stby,g_check] sat=5 & gstage=0 -> pr_build : (gstage'=1) + 1-pr_build : true;
  [e_wait,o_stby,g_build] sat=5 & gstage=1 -> 1 : (gstage'=2);
  [e_wait,o_stby,g_launch] sat=5 & gstage=2 -> Pn : (sat'=0) & (win'=0) & (gstage'=0) & (last'=2) + 1-Pn : true;
endmodule

// module to count the rounds
module rounds

  rounds : [0..k+1] init 0;

  [] rounds<=k -> (rounds'=rounds+1);
  [] rounds=k+1 -> true;

endmodule

label "normal" = sat=0;
label "Loss_Continuity" = sat=1 | sat=2 | sat=4 | sat=5 | sat=7;
label "Loss_Integrity" = sat=6;
label "replace" = last=1;
label "manufacture" = last=2;

rewards "Loss_Continuity"
  sat=1 | sat=2 | sat=4 | sat=5 | sat=7 : 1;
endrewards

rewards "Loss_Integrity"
  sat=6 : 1;
endrewards

rewards "replace"
  last=1 : 1;
endrewards

rewards "manufacture"
  last=2 : 1;
endrewards

rewards "replaceOrManufacture"
  last>0 : 1;
endrewards

// Communication semantics
// Connector Environment.mon -> Maintenance.env: documentation only (Environment has no action "mon", Maintenance has no action "env")
// Connector OnOrbitStaff.mon -> Maintenance.orbit: documentation only (OnOrbitStaff has no action "mon", Maintenance has no action "orbit")
// Connector OnGroundStaff.mon -> Maintenance.ground: documentation only (OnGroundStaff has no action "mon", Maintenance has no action "ground")

// rPATL properties: see the generated .props file
// <<env>> Pmax=? [ F ("Loss_Continuity" & rounds<=k) ]
// <<env>> R{"Loss_Continuity"}max=? [ F rounds=k ]
// <<env>> Pmax=? [ F ("Loss_Integrity" & rounds<=k) ]
// <<env>> R{"Loss_Integrity"}max=? [ F rounds=k ]
// <<env,o>> Pmax=? [ F ("replace" & rounds<=k) ]
// <<env,g>> Pmax=? [ F ("manufacture" & rounds<=k) ]
// <<env,o,g>> Pmax=? [ F (("replace" | "manufacture") & rounds<=k) ]
// <<env,o>> R{"replace"}max=? [ F rounds=k ]
// <<env,g>> R{"manufacture"}max=? [ F rounds=k ]
// <<env,o,g>> R{"replaceOrManufacture"}max=? [ F rounds=k ]
// <<o,g>> R{"Loss_Continuity"}min=? [ F rounds=k ]
