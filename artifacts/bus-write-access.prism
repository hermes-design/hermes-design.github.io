// PRISM-games CSG (concurrent stochastic game) generated by HERMES / CPC Modeler
csg

player p1 player1 endplayer
player p2 player2 endplayer

const int k = 10;

module player1
  ready1 : [0..1] init 0; // 0: READY

  [w1] ready1=0 & (s=0) -> 1 : (ready1'=0);
  [r1] ready1=0 & (s=0) -> 1 : (ready1'=0);
  [unlock_1] ready1=0 & (s=0) -> 1 : (ready1'=0);
  [reset_1] ready1=0 & (s>0) -> 1 : (ready1'=0);
endmodule

module communicationbus
  s : [0..10] init 0;
  win : [0..2] init 0;

  [unlock_1,unlock_2] s=0 -> 1 : (s'=0) & (win'=0);
  [w1,w2] s=0 -> 1 : (s'=1) & (win'=0);
  [r1,r2] s=0 -> 1 : (s'=1) & (win'=0);
  [w1,r2] s=0 -> 1 : (s'=3) & (win'=1);
  [r1,w2] s=0 -> 1 : (s'=2) & (win'=2);
  [reset_1,reset_2] s=1|s=2|s=3 -> 1 : (s'=0) & (win'=0);
endmodule

module player2
  ready2 : [0..1] init 0; // 0: READY

  [w2] ready2=0 & (s=0) -> 1 : (ready2'=0);
  [r2] ready2=0 & (s=0) -> 1 : (ready2'=0);
  [unlock_2] ready2=0 & (s=0) -> 1 : (ready2'=0);
  [reset_2] ready2=0 & (s>0) -> 1 : (ready2'=0);
endmodule

// module to count the rounds
module rounds

  rounds : [0..k+1] init 0;

  [] rounds<=k -> (rounds'=rounds+1);
  [] rounds=k+1 -> true;

endmodule

label "win1" = win=1;
label "win2" = win=2;

rewards "utility1"
  [r1,w2] true : -1;
  [r1,r2] true : 0;
  [w1,r2] true : 1;
  [w1,w2] true : 0;
endrewards

rewards "utility2"
  [w1,r2] true : -1;
  [r1,r2] true : 0;
  [r1,w2] true : 1;
  [w1,w2] true : 0;
endrewards

// Communication semantics
// Connector Player1.bus -> CommunicationBus.in1: documentation only (Player1 has no action "bus", CommunicationBus has no action "in1")
// Connector Player2.bus -> CommunicationBus.in2: documentation only (Player2 has no action "bus", CommunicationBus has no action "in2")

// rPATL properties: see the generated .props file
// <<p1>> Pmax=? [ F win=1 ]
// <<p1,p2>> Pmax=? [ F win=1 ]
// <<p1>> P>0.99 [ F win=1 ]
// <<p1,p2>> Pmax=? [ F (win=1 & rounds<=k) ]
// <<p1>> R{"utility1"}max=? [ F rounds=k ]
// <<p1,p2>> R{"utility1"}max=? [ F rounds=k ]
