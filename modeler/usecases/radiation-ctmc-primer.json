{
  "id": "radiation-ctmc-primer",
  "title": "Radiation upsets and operator response",
  "chapter": "Use case 1 — Radiation effects on a satellite",
  "chapterOrder": 1,
  "formalism": "ctmc",
  "tool": "PRISM 4.x (or PRISM-games)",
  "prismOptions": "-gaussseidel",
  "summary": "A first CTMC: an on-board computer hit by SEUs (scrubbed automatically) and SEFIs (reset by a human operator who is not always on duty).",
  "description": [
    "The on-board computer (OBC) is NOMINAL, suffers a Single Event Upset (SEU) that EDAC/scrubbing corrects, or a Single Event Functional Interrupt (SEFI) that needs a reset command.",
    "The reset is a synchronised action between the OBC and the Operator module: it can only happen while an operator is ON_DUTY. This is a device effect becomes an outage only if nobody repairs it in time.",
    "Rates follow λ = 1/MTBF and μ = 1/MTTR. The default values are teaching values (hours) — replace them with SEE rates from radiation testing."
  ],
  "objectives": [
    "Translate MTBF / MTTR figures into CTMC rates.",
    "Understand synchronisation of rates in a CTMC (rate of [reset] = 1 × mu_reset).",
    "Read steady-state (S) and time-bounded (P, R with C<=T) CSL properties."
  ],
  "exercises": [
    "Halve MTTR_reset: how much does the steady-state availability improve?",
    "Set the operator always on duty (MTTF_shift very large): what is the gain? What does it cost in staff?",
    "Plot P=? [ F<=T \"sefi\" ] for T from 24 h to 8760 h (Experiments in PRISM)."
  ],
  "parameters": [
    {
      "name": "MTBF_SEU",
      "label": "MTBF between SEUs",
      "value": "48",
      "unit": "h",
      "description": "Mean time between two single event upsets on the OBC memory",
      "source": "Teaching value — use SEE rate σ·Φ from testing"
    },
    {
      "name": "MTTR_scrub",
      "label": "Scrubbing time",
      "value": "0.1",
      "unit": "h",
      "description": "Mean time for EDAC / scrubbing to correct an SEU",
      "source": "Teaching value"
    },
    {
      "name": "MTBF_SEFI",
      "label": "MTBF between SEFIs",
      "value": "2000",
      "unit": "h",
      "description": "Mean time between functional interrupts",
      "source": "Teaching value"
    },
    {
      "name": "MTTR_reset",
      "label": "Operator reset time",
      "value": "4",
      "unit": "h",
      "description": "Mean time for the operator to diagnose and reset",
      "source": "Teaching value"
    },
    {
      "name": "MTTF_shift",
      "label": "Mean on-duty period",
      "value": "8",
      "unit": "h",
      "description": "Mean time an operator stays on duty",
      "source": "Teaching value"
    },
    {
      "name": "MTTR_shift",
      "label": "Mean off-duty period",
      "value": "16",
      "unit": "h",
      "description": "Mean time without operator",
      "source": "Teaching value"
    },
    {
      "name": "T",
      "label": "Mission time bound",
      "value": "720",
      "unit": "h",
      "description": "Time bound of the transient properties (720 h = 1 month)"
    }
  ],
