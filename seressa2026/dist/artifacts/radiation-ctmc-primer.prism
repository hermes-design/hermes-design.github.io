// PRISM CTMC (continuous-time Markov chain) generated by HERMES / CPC Modeler
ctmc

const double MTBF_SEU = 48;
const double MTTR_scrub = 0.1;
const double MTBF_SEFI = 2000;
const double MTTR_reset = 4;
const double MTTF_shift = 8;
const double MTTR_shift = 16;
const double T = 720;
const double lambda_seu = 1/MTBF_SEU;
const double mu_scrub = 1/MTTR_scrub;
const double lambda_sefi = 1/MTBF_SEFI;
const double mu_reset = 1/MTTR_reset;
const double lambda_off = 1/MTTF_shift;
const double mu_on = 1/MTTR_shift;

module obc
  obc : [0..2] init 0; // 0: NOMINAL, 1: SEU, 2: SEFI

  [] obc=0 -> lambda_seu : (obc'=1) + lambda_sefi : (obc'=2);
  [] obc=1 -> mu_scrub : (obc'=0);
  [reset] obc=2 -> mu_reset : (obc'=0);
endmodule

module operator
  op : [0..1] init 0; // 0: ON_DUTY, 1: OFF_DUTY

  [] op=0 -> lambda_off : (op'=1);
  [] op=1 -> mu_on : (op'=0);
  [reset] op=0 -> 1 : (op'=0);
endmodule

label "up" = obc=0;
label "seu" = obc=1;
label "sefi" = obc=2;

rewards "downtime"
  obc>0 : 1;
endrewards

rewards "resets"
  [reset] true : 1;
endrewards

// Communication semantics
// Sync connector Operator.reset -> OBC.reset: rendezvous on [reset]

// CSL properties: see the generated .props file
// S=? [ "up" ]
// P=? [ F<=T "sefi" ]
// R{"downtime"}=? [ C<=T ]
// R{"resets"}=? [ C<=T ]
// R{"downtime"}=? [ S ]
