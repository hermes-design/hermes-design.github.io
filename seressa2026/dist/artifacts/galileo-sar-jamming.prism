// PRISM CTMC (continuous-time Markov chain) generated by HERMES / CPC Modeler
ctmc

const int OPERATIONAL = 0;
const int DEGRADED = 1;
const int NO_ATTACK = 0;
const int JAMMED = 1;
const int IDLE = 0;
const int NULLING = 1;
const double lambda_sat = 2.03e-8;
const double mu_sat = 4.03e-6;
const double lambda_sig = 1e-3;
const double mu_sig = 8.7e-6;
const double MTTA = 10;
const double lambda_jam = 1/MTTA;
const double mu_jam = 0.5;
const double alpha = 10;
const double lambda_null = alpha*lambda_jam;
const double mu_null = 0.5;
const bool REACTIVE = false;
const double T = 100;

formula system_up = (SAT=OPERATIONAL) & (SIG=OPERATIONAL) & ((ATT=NO_ATTACK) | (ATT=JAMMED & DEF=NULLING));

module satellite
  SAT : [0..1] init 0; // 0: OPERATIONAL, 1: DEGRADED

  [] SAT=0 -> lambda_sat : (SAT'=1);
  [] SAT=1 -> mu_sat : (SAT'=0);
endmodule

module signal
  SIG : [0..1] init 0; // 0: OPERATIONAL, 1: DEGRADED

  [] SIG=0 -> lambda_sig : (SIG'=1);
  [] SIG=1 -> mu_sig : (SIG'=0);
endmodule

module attack
  ATT : [0..1] init 0; // 0: NO_ATTACK, 1: JAMMED

  [] ATT=0 -> lambda_jam : (ATT'=1);
  [] ATT=1 -> mu_jam : (ATT'=0);
endmodule

module defence
  DEF : [0..1] init 0; // 0: IDLE, 1: NULLING

  [] DEF=0 & (!REACTIVE | ATT=JAMMED) -> lambda_null : (DEF'=1);
  [] DEF=1 -> mu_null : (DEF'=0);
endmodule

label "up" = system_up;
label "jammed" = ATT=JAMMED;
label "defended" = ATT=JAMMED & DEF=NULLING;

rewards "defense"
  ATT=JAMMED & DEF=NULLING : 1;
endrewards

rewards "downtime"
  !system_up : 1;
endrewards

// CSL properties: see the generated .props file
// P=? [ "up" U<=T !"up" ]
// P=? [ F<=T "jammed" ]
// 1 - R{"downtime"}=? [ C<=T ] / T
// R{"defense"}=? [ C<=T ] / T
// R{"downtime"}=? [ C<=T ]
