// CSL properties generated by HERMES / CPC Modeler

// Availability — long-run probability that the OBC is nominal
S=? [ "up" ]

// SEFI within T — probability of at least one SEFI within T
P=? [ F<=T "sefi" ]

// Expected downtime — expected time (h) without service up to T
R{"downtime"}=? [ C<=T ]

// Expected resets — expected number of operator resets up to T
R{"resets"}=? [ C<=T ]

// Long-run downtime rate — fraction of time without service
R{"downtime"}=? [ S ]

