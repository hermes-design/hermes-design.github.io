// rPATL properties generated by HERMES / CPC Modeler

// PRO1 Continuity
<<env>> Pmax=? [ F ("Loss_Continuity" & rounds<=k) ]

// PRO2 Continuity (expected) — expected rounds without service within k rounds
<<env>> R{"Loss_Continuity"}max=? [ F rounds=k ]

// PRO3 Integrity
<<env>> Pmax=? [ F ("Loss_Integrity" & rounds<=k) ]

// PRO4 Integrity (expected)
<<env>> R{"Loss_Integrity"}max=? [ F rounds=k ]

// PRO5 Reliability, on-orbit staff
<<env,o>> Pmax=? [ F ("replace" & rounds<=k) ]

// PRO6 Reliability, on-ground staff
<<env,g>> Pmax=? [ F ("manufacture" & rounds<=k) ]

// PRO7 Reliability, both teams
<<env,o,g>> Pmax=? [ F (("replace" | "manufacture") & rounds<=k) ]

// PRO8 Maintainability, on-orbit
<<env,o>> R{"replace"}max=? [ F rounds=k ]

// PRO8b Maintainability, on-ground
<<env,g>> R{"manufacture"}max=? [ F rounds=k ]

// PRO9 Maintainability, both teams
<<env,o,g>> R{"replaceOrManufacture"}max=? [ F rounds=k ]

// Humans vs. environment — outage the two teams can guarantee against a worst-case environment — the same zero-sum game as PRO2, hence the same value
<<o,g>> R{"Loss_Continuity"}min=? [ F rounds=k ]

