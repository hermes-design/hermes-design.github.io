// rPATL properties generated by HERMES / CPC Modeler

// P1 alone — can player 1 force a win on its own? (expected: 0)
<<p1>> Pmax=? [ F win=1 ]

// Coalition — can the coalition make player 1 win? (expected: 1)
<<p1,p2>> Pmax=? [ F win=1 ]

// P1 alone, bounded — slide 17 — Boolean query
<<p1>> P>0.99 [ F win=1 ]

// Win within k rounds
<<p1,p2>> Pmax=? [ F (win=1 & rounds<=k) ]

// Guaranteed utility of P1 — what player 1 can guarantee within k rounds, whatever p2 does
<<p1>> R{"utility1"}max=? [ F rounds=k ]

// Cooperative utility of P1
<<p1,p2>> R{"utility1"}max=? [ F rounds=k ]

