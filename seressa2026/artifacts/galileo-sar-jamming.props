// CSL properties generated by HERMES / CPC Modeler

// Degraded within T — slide 40 — probability that the service goes down within T
P=? [ "up" U<=T !"up" ]

// Jammed within T
P=? [ F<=T "jammed" ]

// Availability over [0,T] — mean fraction of [0,T] with the service up
1 - R{"downtime"}=? [ C<=T ] / T

// Expected defence reward — fraction of [0,T] spent jammed AND defended (compare with slide 42)
R{"defense"}=? [ C<=T ] / T

// Expected downtime
R{"downtime"}=? [ C<=T ]

