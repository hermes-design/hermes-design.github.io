- name: snippet_sinr
  id: snippet
  parameters:
    alias: ''
    code: def get_measured_sinr_db(self):\n    import math\n    p_sig = self.probe_sinr_sig.level()\n    p_jam
      = self.probe_sinr_jam.level()\n    eps = 1e-20\n    return 10.0 * math.log10((p_sig
      + eps) / (p_jam + eps))\ntype(self).get_measured_sinr_db = get_measured_sinr_db\n
    comment: ''
    priority: '0'
    section: main_after_init
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [460, 1080.0]
    rotation: 0
    state: 'true'
