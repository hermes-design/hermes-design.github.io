// ============================================================
//  CTMC PARAMETRIQUE de la defense IA -- taux PAR ZONE (angle,puissance)
//  (genere depuis ctmc_rates_grid.csv)
//
//  La constante 'zone' selectionne l'etat d'attaque (0..53).
//  En Experiment PRISM : balayer zone de 0 a 53 pour obtenir
//  la fiabilite par zone d'attaque.
//
//  Correspondance zone -> (angle, puissance) : voir rates_table.txt
// ============================================================

ctmc

// Selecteur de zone d'attaque (a balayer en Experiment : 0..53)
const int zone;

// Taux mesures, selectionnes par zone via formules :
formula mu_react =
